rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile documents
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Username lookup for uniqueness verification
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Stories (temporary 24h posts)
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    // Curtidas
    match /curtidas/{curtidaId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // Visualizacoes
    match /visualizacoes/{viewId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comments collection with nested replies
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.autor_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.autor_id == request.auth.uid;
    }

    // Conversas (Direct Messages & Groups)
    match /conversas/{conversaId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Mensagens
    match /mensagens/{mensagemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.autor_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.autor_id == request.auth.uid;
    }

    // Notificacoes
    match /notificacoes/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Mencao (Mentions tracking)
    match /mencao/{mencaoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Hashtags and post_hashtag junction
    match /hashtags/{hashtagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /post_hashtag/{postHashtagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Salvos (Saved Posts)
    match /salvos/{salvoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Denuncias
    match /denuncias/{denunciaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.denunciante_id == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // Bloqueios
    match /bloqueios/{bloqueioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.usuario_bloqueador_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.usuario_bloqueador_id == request.auth.uid;
    }

    // Solicitações de seguir (contas privadas)
    match /solicitacoes_seguir/{reqId} {
      allow read, write: if request.auth != null;
    }

    // Solicitações de verificação (Selo de verificado)
    match /solicitacoes_verificacao/{reqId} {
      allow read, write: if request.auth != null;
    }
  }
}
